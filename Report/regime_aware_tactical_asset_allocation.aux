\@writefile{lof}{\contentsline {figure}{\numberline {D.18}{\ignorespaces Coupled teacher: majority-vote construction. Each panel restricts the ensemble to a scope ($L^2$ members, $L^1$-medoid members, or all $22$ combined), shades the equity excess-return index by the scope's majority joint regime, and overlays the majority-class vote share on the right axis. Because the label is a plurality (argmax) vote over three regimes, the winning share is always at least $1/3$; the dashed line marks this $1/3$ floor, so a share near the line indicates a near three-way split among the members (weak consensus) and a share approaching $1$ indicates strong agreement on a single joint regime.}}{33}{figure.caption.66}\protected@file@percent }
\newlabel{fig:c-majvote}{{D.18}{33}{Coupled teacher: majority-vote construction. Each panel restricts the ensemble to a scope ($L^2$ members, $L^1$-medoid members, or all $22$ combined), shades the equity excess-return index by the scope's majority joint regime, and overlays the majority-class vote share on the right axis. Because the label is a plurality (argmax) vote over three regimes, the winning share is always at least $1/3$; the dashed line marks this $1/3$ floor, so a share near the line indicates a near three-way split among the members (weak consensus) and a share approaching $1$ indicates strong agreement on a single joint regime}{figure.caption.66}{}}
