% neuripsstyle.sty -- faithful emulation of the NeurIPS single-column paper format
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neuripsstyle}[2024/01/01 NeurIPS-style emulation]

\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1in,bottom=1in]{geometry}
\RequirePackage{titlesec}
\RequirePackage{titling}

% --- spacing ---
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\renewcommand{\baselinestretch}{1.0}
\setlength{\emergencystretch}{2.5em}

% --- section headers: bold, NeurIPS-like sizes ---
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4ex plus .2ex}{0.8ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.0ex plus .2ex}{0.5ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{0.9ex plus .2ex}{0.4ex plus .2ex}

% --- title block with the characteristic NeurIPS rules ---
\newcommand{\@nipsrule}{\noindent\rule{\textwidth}{1pt}}
\renewcommand{\maketitle}{%
  \par
  \begin{center}
    \@nipsrule\\[0.6ex]
    {\LARGE\bfseries \@title \par}\vspace{0.6ex}
    \@nipsrule\\[1.4ex]
    {\normalsize \@author \par}\vspace{0.4ex}
    {\normalsize \@date \par}
  \end{center}
  \vspace{0.8em}
}
